# Copy to .env.local (git-ignored) and fill in. Never commit keys or paste them into chat or the hub.

# Claude, for the orchestrator. console.anthropic.com > API keys.
ANTHROPIC_API_KEY=

# Meta Model API, for the Muse subagents (model muse-spark-1.3). dev.meta.ai > API keys.
# Must be Model API credit, not the Muse Code terminal subscription.
MODEL_API_KEY=

# LangSmith, for traces of every run (free tier). smith.langchain.com > Settings > API keys.
LANGSMITH_API_KEY=
# Traces keep the shape of each run and token counts only, never prompts, tool results or round numbers
# (src/tracing.ts). Set to false to send nothing to LangSmith.
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=jester-referee-coach

# Off unless Aaron turns it on. When true, the agent also reads rounds real players played on the live site and sends
# numbers derived from them (scores, per-limb credit, lag, outline fit, round ids, clip ids) to Anthropic and the Meta
# Model API. Off: only the simulated stand-in player's rounds and the cases derived from them. README, "What leaves
# this laptop".
JESTER_SEND_REAL_PLAYER_ROUNDS_TO_MODELS=false
